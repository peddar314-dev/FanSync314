<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B1020">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FanSync"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="28dp"/>

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Away Game Demo"
            android:textColor="#B7C0D8"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="28dp"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready for synchronized cheering"
            android:textColor="#E5E7EB"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="18dp"/>

        <TextView
            android:id="@+id/countdown"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:text="JOINED"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <EditText
            android:id="@+id/cheerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cheer message"
            android:text="GO TEAM!"
            android:textColor="#FFFFFF"
            android:textColorHint="#9CA3AF"
            android:backgroundTint="#9CA3AF"
            android:textSize="20sp"
            android:padding="14dp"/>

        <Button
            android:id="@+id/triggerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trigger 5-Second Cheer"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:layout_marginTop="22dp"
            android:padding="14dp"/>

        <Button
            android:id="@+id/resetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:layout_marginTop="12dp"
            android:padding="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This first APK is a self-contained demo. Multi-phone synchronization will be added after you approve the basic experience."
            android:textColor="#9CA3AF"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="28dp"
            android:paddingBottom="24dp"/>
    </LinearLayout>
</ScrollView>
