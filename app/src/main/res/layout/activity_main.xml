<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/brand"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="28dp"/>

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textColor="#B7C0D8"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="28dp"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ready"
            android:textColor="#E5E7EB"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="18dp"/>

        <TextView
            android:id="@+id/countdown"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:text="@string/joined"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <EditText
            android:inputType="textCapSentences"
            android:maxLength="80"
            android:importantForAutofill="no"
            android:id="@+id/cheerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cheer_hint"
            android:text="@string/default_cheer"
            android:textColor="#FFFFFF"
            android:textColorHint="#9CA3AF"
            android:backgroundTint="#9CA3AF"
            android:textSize="20sp"
            android:padding="14dp"/>

        <Button
            android:id="@+id/triggerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trigger"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:layout_marginTop="22dp"
            android:padding="14dp"/>

        <Button
            android:id="@+id/resetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:layout_marginTop="12dp"
            android:padding="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/demo_note"
            android:textColor="#9CA3AF"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingTop="28dp"
            android:paddingBottom="24dp"/>
    </LinearLayout>
</ScrollView>
